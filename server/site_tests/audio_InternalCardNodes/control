from autotest_lib.server import utils

NAME = "audio_InternalCardNodes"
METADATA = {
    "contacts": ["chromeos-audio-bugs@google.com"],
    "bug_component": "b:875558",
    "criteria": "This test will fail if the plugged nodes are not expected.",
    'variant_category': '{"name": "Audio_SoC_Codec_Amp"}',
}

TEST_TYPE = "server"
ATTRIBUTES = "suite:audio_essential, group:release-health, release-health_audio"
DEPENDENCIES = "audio_box, test_audiojack, chameleon_state:WORKING"
JOB_RETRIES = 1

args_dict = utils.args_to_dict(args)
chameleon_args = hosts.CrosHost.get_chameleon_arguments(args_dict)

"""
This test remotely tests plugged audio nodes for internal cards.
"""

def run(machine):
    host = hosts.create_host(machine, chameleon_args=chameleon_args)
    job.run_test("audio_InternalCardNodes", host=host,
                 blocked_models=['coachz',    # Device with no audiojack port
                                 'dochi',  # skip, see discussion at b/411120933
                                ])

parallel_simple(run, machines)
