# The test verifies that a classic HID device will not wake a convertible in tablet mode.
#
# Steps:
# 1. Set tablet mode on the DUT of convertible form factor.
# 2. The DUT pairs and connects to a classic HID device.
# 3. Suspend the DUT.
# 4. Use the HID device to try waking up the DUT.
# 5. Expect the DUT does not wake up
#
# Purpose: Verify classic HID peer device can not wake the convertible in tablet mode
# from suspend

# Deprecated variables:
#     TIME = 'SHORT'
#     TEST_CATEGORY = 'Functional'

from autotest_lib.server import utils

NAME = 'bluetooth_AdapterSRHealth.sr_peer_wake_classic_hid_tablet_should_fail.floss'
METADATA = {
    'contacts': ['chromeos-bt-team@google.com'],
    # ChromeOS > Platform > Connectivity > Bluetooth
    'bug_component': 'b:167317',
    'criteria': 'Pass test',
    'hw_agnostic': False,
    'variant_category': '{"name": "BT_Chipset_Kernel_Tablet_Suspend_Power_Down"}',
    'requirements': ['bt-phy-0005-v01', 'bt-phy-0007-v01', 'bt-phy-0008-v01',
                     'bt-phy-0010-v01', 'bt-drv-0014-v01']
}


ATTRIBUTES = 'suite:bluetooth_floss_flaky'
TEST_TYPE = 'server'
DEPENDENCIES = 'bluetooth_state:NORMAL, working_bluetooth_btpeer:1'


args_dict = utils.args_to_dict(args)

def run(machine):
    host = hosts.create_host(machine)
    job.run_test('bluetooth_AdapterSRHealth', host=host, num_iterations=1,
                 args_dict=args_dict, test_name=NAME.split('.')[1], tag='.'.join(NAME.split('.')[1:]), floss=True,
                 floss_lm_quirk=True)

parallel_simple(run, machines)
